@model IEnumerable<EventEase.Models.Event>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Events</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<a class="btn btn-primary mb-3" href="/Event/Create">Add Event</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Date</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EventName</td>
                <td>@item.EventDate.ToShortDateString()</td>
                <td>@item.Description</td>
                <td>
                    <a class="btn btn-warning btn-sm" href="/Event/Edit/@item.EventId">Edit</a>
                    <a class="btn btn-danger btn-sm" href="/Event/Delete/@item.EventId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>