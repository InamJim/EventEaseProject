@model EventEase.ViewModels.EventFilterViewModel

<h2>Events</h2>

<form method="get">

    <div class="row mb-3">

        <div class="col-md-3">

            <label>Event Type</label>

            <select name="eventTypeId"
                    class="form-control">

                <option value="">
                    All
                </option>

                @foreach ( var type in Model.EventTypes )
                {
                    <option value="@type.EventTypeId">
                        @type.Name
                    </option>
                }

            </select>

        </div>

        <div class="col-md-2">

            <label>Available</label>

            <select name="availability"
                    class="form-control">

                <option value="">
                    All
                </option>

                <option value="true">
                    Available
                </option>

                <option value="false">
                    Unavailable
                </option>

            </select>

        </div>

        <div class="col-md-2">

            <label>Start Date</label>

            <input type="date"
                   name="startDate"
                   class="form-control" />

        </div>

        <div class="col-md-2">

            <label>End Date</label>

            <input type="date"
                   name="endDate"
                   class="form-control" />

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-primary mt-4">
                Search
            </button>

        </div>

    </div>

</form>

<table class="table table-bordered">

    <thead>

        <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Date</th>
            <th>Venue</th>
            <th>Available</th>
        </tr>

    </thead>

    <tbody>

        @foreach ( var item in Model.Events )
        {
            <tr>

                <td>@item.EventName</td>

                <td>@item.EventType?.Name</td>

                <td>
                    @item.EventDate.ToShortDateString()
                </td>

                <td>
                    @item.Venue?.VenueName
                </td>

                <td>
                    @(item.Venue?.Availability == true
                        ? "Yes"
                        : "No")
                </td>

            </tr>
        }

    </tbody>

</table>